[Unit]
Description=MCP Server
After=network.target oslo.mount

[Service]
Type=simple
User=inroki
WorkingDirectory=/oslo/share/mcp-server
EnvironmentFile=/oslo/share/mcp-server/.env
ExecStart=/oslo/share/mcp-server/venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
