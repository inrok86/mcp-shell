PORT=3000
PUBLIC_URL=https://mcp.example.com

AUTHENTIK_ISSUER=https://auth.example.com/application/o/mcp-server/
AUTHENTIK_AUTHORIZE_URL=https://auth.example.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://auth.example.com/application/o/token/
AUTHENTIK_INTROSPECT_URL=https://auth.example.com/application/o/introspect/
AUTHENTIK_USERINFO_URL=https://auth.example.com/application/o/userinfo/

CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

MCP_GROUP=mcp-users

# ── Wiki.js 연동 (선택) ───────────────────────────────────────────────────────
# WIKI_URL            Wiki.js 서버 주소
# WIKI_API_KEY_FILE   관리자 API 키 파일 경로
# WIKI_LOCALE         페이지 로케일 (기본: en)
# WIKI_HOME_PREFIX    유저 홈 경로 접두사 (없으면 wiki.xyz/{username} 그대로)
# WIKI_COMMON_PATHS   공용 경로 (콤마 구분), 모든 인증 유저 읽기/쓰기 허용
WIKI_URL=https://wiki.example.com
WIKI_API_KEY_FILE=~/wiki.key
WIKI_LOCALE=en
WIKI_HOME_PREFIX=
WIKI_COMMON_PATHS=common,public
# 위키 컨벤션 파일 경로 (tool docstring에 자동 주입, 선택)
WIKI_SCHEMA_FILE=~/wiki_schema.md
